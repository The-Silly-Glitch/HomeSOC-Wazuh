<!-- Custom Detection Rules mapped to MITRE ATT&CK -->
<!-- Location: /var/ossec/etc/rules/custom_rules.xml -->

<group name="windows,windows_simulation,sysmon,endpoint,syscheck,custom_fim,">

  <!-- Rule 100100: Ingestion Base Rule for simulated Windows events -->
  <rule id="100100" level="3">
    <field name="source">^windows_sim$</field>
    <description>Simulated Windows Event Ingestion Base Rule</description>
  </rule>

  <!-- Rule 100101: MITRE T1059.001 - Command and Scripting Interpreter: PowerShell -->
  <rule id="100101" level="8">
    <if_sid>100100</if_sid>
    <field name="CommandLine">-enc|-encodedcommand|frombase64string|downloadstring|iex\s+\(|bypass\s+-nop</field>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <description>Suspicious PowerShell Execution or Encoded Command Detected [T1059.001]</description>
    <group>attack.execution,attack.t1059.001,</group>
  </rule>

  <!-- Rule 100102: MITRE T1053.005 - Scheduled Task/Job: Scheduled Task -->
  <rule id="100102" level="7">
    <if_sid>100100</if_sid>
    <field name="EventID">^4698$|^106$</field>
    <description>Persistence via Scheduled Task Creation Detected [T1053.005]</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>attack.persistence,attack.privilege_escalation,attack.t1053.005,</group>
  </rule>

  <!-- Rule 100103: MITRE T1078 - Valid Accounts -->
  <rule id="100103" level="8">
    <if_sid>100100</if_sid>
    <field name="EventID">^4624$</field>
    <field name="LogonType">^10$|^3$</field>
    <field name="TargetUserName">administrator|root|admin</field>
    <description>Suspicious Remote Privileged Account Logon Detected [T1078]</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>attack.initial_access,attack.defense_evasion,attack.t1078,</group>
  </rule>

  <!-- Rule 100104: MITRE T1003.001 - OS Credential Dumping: LSASS Memory -->
  <rule id="100104" level="12">
    <if_sid>100100</if_sid>
    <field name="EventID">^10$</field>
    <field name="TargetImage">lsass\.exe</field>
    <description>LSASS Memory Access - Potential Credential Dumping [T1003.001]</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>attack.credential_access,attack.t1003.001,</group>
  </rule>

  <!-- Rule 100105: MITRE T1082 - System Information Discovery -->
  <rule id="100105" level="4">
    <if_sid>100100</if_sid>
    <field name="CommandLine">systeminfo|whoami\s+/all|net\s+user|tasklist</field>
    <description>System Information Discovery via Command Line [T1082]</description>
    <mitre>
      <id>T1082</id>
    </mitre>
    <group>attack.discovery,attack.t1082,</group>
  </rule>

  <!-- Rule 100110: MITRE T1565.001 - Critical File Modification -->
  <rule id="100110" level="7">
    <if_group>syscheck</if_group>
    <match>/monitored/|/etc/shadow|/etc/passwd</match>
    <description>Critical Monitored Directory or System File Modified [T1565.001]</description>
    <mitre>
      <id>T1565.001</id>
    </mitre>
    <group>attack.defense_evasion,attack.t1565.001,</group>
  </rule>

</group>
