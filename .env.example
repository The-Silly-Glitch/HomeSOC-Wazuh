# Wazuh Docker Environment Configuration Template
# Copy this file to .env and adjust variables as required

# Wazuh Stack Version
WAZUH_VERSION=4.11.2

# OpenSearch Indexer Credentials
INDEXER_USERNAME=admin
INDEXER_PASSWORD=SecretPassword

# OpenSearch Heap Limits (Default: 1GB min, 1GB max for lightweight lab)
INDEXER_JAVA_OPTS=-Xms1g -Xmx1g

# Wazuh API & UI Credentials
API_USERNAME=wazuh-wui
API_PASSWORD=MyS3cr37P450r.*-

# Dashboard Internal User
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=kibanaserver

# Host Listening Ports
DASHBOARD_PORT=443
INDEXER_PORT=9200
MANAGER_API_PORT=55000
AGENT_EVENTS_PORT=1514
AGENT_REGISTRATION_PORT=1515
SYSLOG_UDP_PORT=514
